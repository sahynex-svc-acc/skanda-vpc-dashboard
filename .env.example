# Firebase Web App config (safe to expose to the browser)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Dashboard server
CONTROL_PLANE_URL=http://127.0.0.1:32000
SESSION_SECRET=generate-a-long-random-secret
COOKIE_SECURE=true
ALLOWED_GOOGLE_EMAILS=you@example.com
SKANDA_DEPLOY_TOKEN=generate-another-long-random-secret

# Firebase Admin SDK. Keep this outside Git.
FIREBASE_SERVICE_ACCOUNT=/skanda-vpc/secrets/firebase-service-account.json
PORT=34000
